APP_NAME=LaravelApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database Configuration (Supabase / PostgreSQL)
# - Direct Connection: Host = aws-0-ap-southeast-1.pooler.supabase.com (or your project direct host), Port = 5432, User = postgres
# - Transaction Pooler: Host = aws-0-ap-southeast-1.pooler.supabase.com (or your project pooler host), Port = 6543, User = postgres.YOUR_PROJECT_ID
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_ID
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
